FIREBOT_API_KEY=
# Optional: signing secret from the FireBot webhook configuration.
# Without it, authenticated API lookups still confirm payments automatically.
FIREBOT_WEBHOOK_SECRET=
# Keep the existing keys to reconcile orders issued before the migration.
POSEIDON_PUBLIC_KEY=
POSEIDON_SECRET_KEY=
# Connect a PRIVATE Vercel Blob store to the project. OIDC uses BLOB_STORE_ID.
BLOB_STORE_ID=
# Local development can alternatively use a private BLOB_READ_WRITE_TOKEN.
BLOB_READ_WRITE_TOKEN=
SITE_URL=https://black-netfiscal.vercel.app
